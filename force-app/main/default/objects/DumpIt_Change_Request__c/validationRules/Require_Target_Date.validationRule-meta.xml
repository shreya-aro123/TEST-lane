<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Target_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(DumpIt_CR_Status__c, &quot;Submitted&quot;), ISBLANK(DumpIt_CR_Target_Date__c))</errorConditionFormula>
    <errorMessage>Enter a target date before submitting.</errorMessage>
</ValidationRule>
